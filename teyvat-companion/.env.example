# Optional cloud accounts / cross-device tracker sync (Supabase)
# Optional overrides for the project configured as a safe publishable-key default in src/lib/supabase.js.
# Usually you can leave both values blank. To use a different project, copy this file to .env.local and set both.
# Use the publishable key only; NEVER put a service_role / secret key in browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
